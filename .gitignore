# Local archives and ad-hoc working files
ignore
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
env/
env-win/
venv/
.venv/

# Build artifacts
build/
dist/
*.spec~

# Secrets and credentials
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
*.p12
*.pfx
*.jks
credentials*.json
client_secret*.json
service-account*.json
*.kdbx

# Local working folders
uploads/
temp/
cache/

# Generated outputs
outputs/
*.xlsx
*.xlsm
*.xls
*.xlsb
*.ods
*.zip

